---
import "@fontsource/bricolage-grotesque/700.css";
import "@fontsource/bricolage-grotesque/800.css";
import "@fontsource/figtree/400.css";
import "@fontsource/figtree/500.css";
import "@fontsource/figtree/600.css";
import "@fontsource/figtree/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import DemoNotice from "../components/DemoNotice.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../lib/data";
import { url } from "../lib/url";
import { formatWhen } from "../lib/dates.mjs";

interface Props {
  title?: string;        // page title; the home page leaves it out
  description?: string;
}
const { title, description } = Astro.props;
const { event } = site;
const fullTitle = title ? `${title} | ${event.title}` : `${event.title}: ${event.full_name}`;
const where = [event.venue, event.city].filter(Boolean).join(", ");
const desc = description ?? [event.full_name, formatWhen(event.start_date, event.end_date), where].filter(Boolean).join(" · ");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url("logo/og-image.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("logo/vibe-mark.svg")} type="image/svg+xml" />
    <link rel="icon" href={url("logo/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url("logo/apple-touch-icon.png")} />
    <link rel="sitemap" href={url("sitemap-index.xml")} />
    <meta name="theme-color" content="#0e6b6b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={event.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#main">Skip to content</a>
    <DemoNotice />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Correct date-dependent content for the visitor's current time, so the
      // site stays right between rebuilds (see TimeWindow.astro and DateList.astro).
      const now = Date.now();
      document.querySelectorAll<HTMLElement>("[data-window]").forEach((el) => {
        const from = el.dataset.from ? Date.parse(el.dataset.from) : -Infinity;
        const until = el.dataset.until ? Date.parse(el.dataset.until) : Infinity;
        el.dataset.state = now < from ? "before" : now > until ? "after" : "during";
      });
      document.querySelectorAll<HTMLElement>("[data-at]").forEach((el) => {
        el.toggleAttribute("data-past", Date.parse(el.dataset.at!) < now);
      });
    </script>
  </body>
</html>
