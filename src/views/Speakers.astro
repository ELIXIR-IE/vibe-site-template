---
import Page from "../layouts/Page.astro";
import SpeakerCard from "../components/SpeakerCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { speakers, pageLabel } from "../lib/data";

const keynotes = speakers.filter((s) => s.role === "keynote");
const invited = speakers.filter((s) => s.role === "invited");
---

<Page title={pageLabel("speakers")}>
  {keynotes.length > 0 && (
    <section class="group">
      <SectionHeading title="Keynote speakers" />
      <div class="grid-auto" style="--min: 240px">{keynotes.map((s) => <SpeakerCard speaker={s} />)}</div>
    </section>
  )}
  {invited.length > 0 && (
    <section class="group">
      <SectionHeading title="Invited speakers" />
      <div class="grid-auto" style="--min: 240px">{invited.map((s) => <SpeakerCard speaker={s} />)}</div>
    </section>
  )}
</Page>

<style>
  .group + .group { padding-top: var(--space-7); }
</style>
