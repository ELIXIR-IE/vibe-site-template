---
import Page from "../layouts/Page.astro";
import Callout from "../components/Callout.astro";
import TimeWindow from "../components/TimeWindow.astro";
import { site, pageLabel, hasPage } from "../lib/data";
import { url } from "../lib/url";
import { formatDate, formatRange } from "../lib/dates.mjs";

const { registration: reg = {}, derived, event } = site;
---

<Page
  title={pageLabel("register")}
  eyebrow={`${event.title} · ${formatRange(event.start_date, event.end_date)}`}
  intro="Register once to join every session. Joining links are sent by email before the event."
>
  <TimeWindow from={derived.registrationOpens} until={derived.registrationCloses}>
    <div data-when="during">
      <Callout tone="accent" title={`Registration is open until ${reg.closes ? formatDate(reg.closes, { weekday: true }) : "the event"}`}>
        <p>It takes about two minutes. You will get a confirmation email straight away.</p>
        {reg.url && <a slot="actions" class="btn btn--cta" href={reg.url} rel="noopener">{reg.button_label ?? "Register now"}</a>}
      </Callout>
    </div>
    <div data-when="before">
      <Callout tone="quiet" title={`Registration opens on ${reg.opens ? formatDate(reg.opens, { weekday: true }) : "a date to be announced"}`}>
        <p>The registration link will appear here on that day.{hasPage("key-dates") && <> See all <a href={url("key-dates")}>key dates</a>.</>}</p>
      </Callout>
    </div>
    <div data-when="after">
      <Callout tone="quiet" title="Registration has closed">
        <p>If you registered, look out for an email with your joining links.{event.contact_email && <> Questions: <a href={`mailto:${event.contact_email}`}>{event.contact_email}</a>.</>}</p>
      </Callout>
    </div>
  </TimeWindow>

  <div class="reg-grid">
    {reg.fees && reg.fees.length > 0 && (
      <section class="stack">
        <h2>Fees</h2>
        <div class="table-wrap">
          <table class="fees">
            <thead><tr><th scope="col">Category</th><th scope="col">Fee</th></tr></thead>
            <tbody>{reg.fees.map((f) => <tr><td>{f.category}</td><td class="fee">{f.fee}</td></tr>)}</tbody>
          </table>
        </div>
      </section>
    )}
    {reg.includes && reg.includes.length > 0 && (
      <section class="stack">
        <h2>Your registration includes</h2>
        <ul class="ticks">{reg.includes.map((i) => <li>{i}</li>)}</ul>
      </section>
    )}
  </div>
</Page>

<style>
  .reg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: var(--space-7);
    margin-top: var(--space-7);
  }
  .table-wrap { overflow-x: auto; }
  .fees { width: 100%; border-collapse: collapse; }
  .fees th, .fees td { text-align: left; padding: var(--space-3) var(--space-2); border-bottom: 1px solid var(--c-border); }
  .fees th { font: 500 var(--fs-tiny) / 1.2 var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); }
  .fee { font-weight: 700; color: var(--c-primary); white-space: nowrap; }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .ticks li { position: relative; padding-left: 1.8rem; }
  .ticks li::before {
    content: "";
    position: absolute;
    left: 0.2rem;
    top: 0.45em;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 3px var(--c-accent-soft);
  }
</style>
