---
import Page from "../layouts/Page.astro";
import Callout from "../components/Callout.astro";
import TimeWindow from "../components/TimeWindow.astro";
import { site, pageLabel } from "../lib/data";
import { formatDate } from "../lib/dates.mjs";

const { registration: reg = {}, derived } = site;
---

<Page title={pageLabel("register")}>
  <TimeWindow from={derived.registrationOpens} until={derived.registrationCloses}>
    <div data-when="during">
      <Callout tone="accent" title={reg.closes ? `Registration closes ${formatDate(reg.closes)}` : "Registration"}>
        {reg.url && <a slot="actions" class="btn btn--cta" href={reg.url} rel="noopener">{reg.button_label ?? "Register"}</a>}
      </Callout>
    </div>
    <div data-when="before">
      <Callout tone="quiet" title={reg.opens ? `Registration opens ${formatDate(reg.opens)}` : "Registration opens: TBC"} />
    </div>
    <div data-when="after">
      <Callout tone="quiet" title="Registration has closed." />
    </div>
  </TimeWindow>

  {reg.fees && reg.fees.length > 0 && (
    <section class="fees-wrap">
      <h2>Fees</h2>
      <div class="table-wrap">
        <table class="fees">
          <thead><tr><th scope="col">Category</th><th scope="col">Fee</th></tr></thead>
          <tbody>{reg.fees.map((f) => <tr><td>{f.category}</td><td class="fee">{f.fee}</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  )}
</Page>

<style>
  .fees-wrap { display: grid; gap: var(--space-4); max-width: 560px; margin-top: var(--space-7); }
  .table-wrap { overflow-x: auto; }
  .fees { width: 100%; border-collapse: collapse; }
  .fees th, .fees td { text-align: left; padding: var(--space-3) var(--space-2); border-bottom: 1px solid var(--c-border); }
  .fees th { font: 500 var(--fs-tiny) / 1.2 var(--f-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); }
  .fee { font-weight: 700; color: var(--c-primary); white-space: nowrap; }
</style>
