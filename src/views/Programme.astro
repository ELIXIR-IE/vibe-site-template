---
import Page from "../layouts/Page.astro";
import SessionRow from "../components/SessionRow.astro";
import { site, programme, pageLabel } from "../lib/data";
import { formatDate } from "../lib/dates.mjs";

const { event } = site;
---

<Page title={pageLabel("programme")} intro={`Times are ${event.timezone_label ?? "local time"}.`}>
  {programme.length > 1 && (
    <nav class="day-nav" aria-label="Days">
      {programme.map((d, i) => (
        <a href={`#day-${i + 1}`}>Day {i + 1}{d.date && `: ${formatDate(d.date, { weekday: true, year: false, short: true })}`}</a>
      ))}
    </nav>
  )}

  {programme.map((d, i) => (
    <section class="day" id={`day-${i + 1}`} aria-labelledby={`day-${i + 1}-h`}>
      <h2 id={`day-${i + 1}-h`}>
        Day {i + 1}{d.date ? `: ${formatDate(d.date, { weekday: true })}` : ""}
      </h2>
      <ol class="sessions">
        {d.sessions.map((s) => <SessionRow session={s} />)}
      </ol>
    </section>
  ))}
</Page>

<style>
  .day-nav { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .day-nav a {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--c-text);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .day-nav a:hover { border-color: var(--c-primary); color: var(--c-primary); }
  .day { padding-top: var(--space-6); scroll-margin-top: 100px; }
  .day h2 { margin-bottom: var(--space-2); }
  .sessions { list-style: none; margin: 0; padding: 0; }
</style>
