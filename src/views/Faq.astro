---
import Page from "../layouts/Page.astro";
import Callout from "../components/Callout.astro";
import { faq, site, pageLabel } from "../lib/data";
import { inlineMarkdown } from "../lib/url";
---

<Page title={pageLabel("faq")} eyebrow={site.event.title} intro="Quick answers about taking part.">
  <div class="faq">
    {faq.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <p set:html={inlineMarkdown(f.a)} />
      </details>
    ))}
  </div>
  {site.event.contact_email && (
    <div class="faq-contact">
      <Callout tone="quiet" title="Still have a question?">
        <p>Email the organisers at <a href={`mailto:${site.event.contact_email}`}>{site.event.contact_email}</a>.</p>
      </Callout>
    </div>
  )}
</Page>

<style>
  .faq { max-width: 780px; margin-top: var(--space-5); border-top: 1px solid var(--c-border); }
  details { border-bottom: 1px solid var(--c-border); }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    font-weight: 600;
    font-size: 1.05rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: "+";
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--c-primary-soft);
    color: var(--c-primary);
    font: 700 1.1rem / 1 var(--f-body);
  }
  details[open] summary::after { content: "–"; background: var(--c-accent-soft); color: var(--c-cta); }
  details p { padding-bottom: var(--space-4); max-width: 65ch; }
  .faq-contact { max-width: 780px; margin-top: var(--space-7); }
</style>
