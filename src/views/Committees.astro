---
import Page from "../layouts/Page.astro";
import PersonGrid from "../components/PersonGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { committees, pageLabel } from "../lib/data";
---

<Page title={pageLabel("committees")}>
  {committees.map((c) => (
    <section class="committee">
      <SectionHeading title={c.name} intro={c.description} />
      <PersonGrid members={c.members} />
    </section>
  ))}
</Page>

<style>
  .committee + .committee { padding-top: var(--space-7); }
</style>
