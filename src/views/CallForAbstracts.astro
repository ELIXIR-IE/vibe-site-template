---
import Page from "../layouts/Page.astro";
import Callout from "../components/Callout.astro";
import TimeWindow from "../components/TimeWindow.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DateList from "../components/DateList.astro";
import { site, timeline, pageLabel } from "../lib/data";
import { formatDate } from "../lib/dates.mjs";

const { abstracts: abs = {}, derived } = site;
const abstractDates = timeline.filter((d) => d.group === "abstracts");
---

<Page title={pageLabel("call-for-abstracts")}>
  <TimeWindow from={derived.abstractsOpen} until={derived.abstractsClose}>
    <div data-when="during">
      <Callout tone="accent" title={abs.deadline ? `Deadline: ${formatDate(abs.deadline)}` : "Deadline: TBC"}>
        {abs.url && <a slot="actions" class="btn btn--cta" href={abs.url} rel="noopener">{abs.button_label ?? "Submit an abstract"}</a>}
      </Callout>
    </div>
    <div data-when="before">
      <Callout tone="quiet" title={abs.opens ? `Submissions open ${formatDate(abs.opens)}` : "Submissions open: TBC"} />
    </div>
    <div data-when="after">
      <Callout tone="quiet" title="The call for abstracts has closed." />
    </div>
  </TimeWindow>

  <div class="cfa-grid">
    <div class="stack-lg">
      {abs.topics && abs.topics.length > 0 && (
        <section>
          <SectionHeading title="Topics" />
          <ul class="list">{abs.topics.map((t) => <li>{t}</li>)}</ul>
        </section>
      )}
      {abs.formats && abs.formats.length > 0 && (
        <section>
          <SectionHeading title="Formats" />
          <ul class="list">{abs.formats.map((f) => <li>{f.name}{f.detail && <span class="muted"> · {f.detail}</span>}</li>)}</ul>
        </section>
      )}
    </div>
    <section aria-labelledby="cfa-dates-h">
      <SectionHeading id="cfa-dates-h" title="Dates" />
      <DateList items={abstractDates} />
    </section>
  </div>
</Page>

<style>
  .cfa-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
    gap: var(--space-7);
    margin-top: var(--space-7);
    align-items: start;
  }
  .list { margin: 0; padding-left: 1.2em; display: grid; gap: var(--space-2); }
  @media (max-width: 860px) { .cfa-grid { grid-template-columns: 1fr; } }
</style>
