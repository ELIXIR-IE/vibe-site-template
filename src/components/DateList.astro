---
// Key dates as a list. Undated entries show "TBC". Once dates are set,
// past dates fade and the next one is marked (checked again in the browser).
import type { KeyDate } from "../lib/data";
import { dayBadge, formatDate, formatRange } from "../lib/dates.mjs";

interface Props { items: KeyDate[]; limit?: number; upcomingOnly?: boolean }
const { items, limit, upcomingOnly = false } = Astro.props;
const now = Date.now();
let list = upcomingOnly ? items.filter((d) => !d.at || Date.parse(d.at) >= now) : items;
if (limit) list = list.slice(0, limit);
const nextIndex = list.findIndex((d) => d.at && Date.parse(d.at) >= now);
---

<ol class="datelist">
  {list.map((d, i) => {
    const b = d.date ? dayBadge(d.date) : null;
    return (
      <li
        class:list={["date", `date--${d.kind}`, { "is-next": i === nextIndex }]}
        data-at={d.at ?? undefined}
        data-past={d.at && Date.parse(d.at) < now ? "" : undefined}
      >
        <span class="date-badge" aria-hidden="true">
          {b ? <><b>{b.day}</b><small>{b.month}</small></> : <small>TBC</small>}
        </span>
        <span class="date-text">
          <span class="date-label">{d.label}</span>
          <span class="date-when">
            {d.date
              ? <time datetime={d.date}>{d.end ? formatRange(d.date, d.end) : formatDate(d.date, { weekday: true })}</time>
              : "Date TBC"}
            {d.note && <> · {d.note}</>}
          </span>
        </span>
      </li>
    );
  })}
</ol>

<style>
  .datelist { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .date {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-2);
  }
  .date-badge {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.3rem;
    min-height: 56px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
  }
  .date-badge b { font: 800 1.35rem / 1 var(--f-display); color: var(--c-primary); font-variant-numeric: tabular-nums; }
  .date-badge small { font: 500 0.66rem / 1 var(--f-mono); text-transform: uppercase; letter-spacing: 0.09em; color: var(--c-muted); }
  .date-text { display: grid; gap: 0.1rem; }
  .date-label { font-weight: 600; }
  .date-when { font-size: var(--fs-small); color: var(--c-muted); }
  .date--deadline .date-badge { border-color: var(--c-accent); }
  .date--deadline .date-badge b { color: var(--c-cta); }
  .date--event .date-badge { border-color: var(--c-primary); border-width: 2px; }
  .date.is-next:not(.date--event) { box-shadow: inset 3px 0 0 var(--c-accent); }
  .date[data-past] { opacity: 0.55; }
  .date[data-past] .date-label { text-decoration: line-through; text-decoration-color: var(--c-muted); }
</style>
