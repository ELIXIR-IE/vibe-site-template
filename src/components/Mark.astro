---
// The flow cell island, drawn inline so it follows the page's light/dark colours.
// Wells and campuses come from data/brand/campuses.yml via scripts/build-logo.mjs.
import { brand } from "../lib/data";

interface Props {
  size?: number;
  label?: string;          // set to make the mark an image with a text alternative
  showCampuses?: boolean;  // add hover titles listing campuses (used on the big map)
  class?: string;
}
const { size = 48, label, showCampuses = false, class: cls } = Astro.props;
---

<svg
  class:list={["mark", cls]}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <path class="mark-bed" d={brand.island}></path>
  {brand.wells.map((w) =>
    w.campuses.length ? (
      <circle class="mark-hit" cx={w.x} cy={w.y} r={brand.hitRadius}>
        {showCampuses && <title>{w.campuses.join("\n")}</title>}
      </circle>
    ) : (
      <circle class="mark-well" cx={w.x} cy={w.y} r={brand.wellRadius} fill-opacity={w.level}></circle>
    )
  )}
</svg>

<style is:global>
  .mark { display: block; flex: none; }
  .mark-bed { fill: var(--c-bed); }
  .mark-well { fill: var(--c-primary); }
  .mark-hit { fill: var(--c-accent); }
</style>
