---
import Mark from "./Mark.astro";
import Countdown from "./Countdown.astro";
import TimeWindow from "./TimeWindow.astro";
import { site, hasPage } from "../lib/data";
import { url } from "../lib/url";
import { formatWhen } from "../lib/dates.mjs";

const { event, derived, host, registration: reg = {}, abstracts: abs = {} } = site;
const where = [event.venue, event.city].filter(Boolean).join(", ");
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="hero-name">{event.title}</span>
        <span class="hero-full">{event.full_name}</span>
      </h1>
      <ul class="hero-facts">
        <li><strong>{formatWhen(event.start_date, event.end_date)}</strong></li>
        {where && <li>{where}</li>}
        {host && <li>Hosted by {host.url ? <a href={host.url}>{host.name}</a> : host.name}</li>}
      </ul>

      <div class="btn-row">
        {hasPage("register") && (
          <TimeWindow as="span" from={derived.registrationOpens} until={derived.registrationCloses}>
            <a class="btn btn--cta" data-when="before during" href={url("register")}>{reg.button_label ?? "Register"}</a>
          </TimeWindow>
        )}
        {hasPage("call-for-abstracts") && (
          <TimeWindow as="span" from={derived.abstractsOpen} until={derived.abstractsClose}>
            <a class="btn btn--ghost" data-when="before during" href={url("call-for-abstracts")}>{abs.button_label ?? "Submit an abstract"}</a>
          </TimeWindow>
        )}
        {hasPage("programme") && <a class="btn btn--ghost" href={url("programme")}>Programme</a>}
      </div>
    </div>

    <div class="hero-side">
      <Mark size={260} class="hero-mark" />
      {derived.eventStart && <Countdown />}
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-border);
    padding-block: var(--space-7);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }
  .hero-copy { display: grid; gap: var(--space-5); justify-items: start; }
  .hero h1 { display: grid; gap: var(--space-2); }
  .hero-name { font-size: var(--fs-hero); font-weight: 800; letter-spacing: -0.015em; color: var(--c-primary); line-height: 1; }
  .hero-full { font: 600 clamp(1.1rem, 1rem + 0.6vw, 1.4rem) / 1.3 var(--f-body); color: var(--c-muted); }
  .hero-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-5); color: var(--c-muted); }
  .hero-facts strong { color: var(--c-text); }
  .hero-side { display: grid; gap: var(--space-5); justify-items: center; }
  .hero-side :global(.hero-mark) { width: min(260px, 60vw); height: auto; }
  .hero-side :global(.countdown) { width: 100%; max-width: 360px; }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-side { justify-items: start; }
    .hero-side :global(.hero-mark) { display: none; }
  }
</style>
