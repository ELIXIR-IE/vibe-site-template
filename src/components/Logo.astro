---
// Logo lockup as live text beside the inline mark.
//   variant="full"  → name + two-line subtitle
//   variant="short" → name only
import Mark from "./Mark.astro";
import { site } from "../lib/data";
import { url } from "../lib/url";
import { twoLines } from "../lib/text.mjs";

interface Props { variant?: "full" | "short"; size?: number }
const { variant = "full", size = variant === "full" ? 50 : 40 } = Astro.props;
const [line1, line2] = twoLines(site.event.full_name);
---

<a class:list={["logo", `logo--${variant}`]} href={url("")}>
  <Mark size={size} />
  <span class="logo-text">
    <span class="logo-name">{site.event.short_name}</span>
    {variant === "full" && (
      <span class="logo-sub"><span>{line1}</span><span>{line2}</span></span>
    )}
  </span>
  <span class="visually-hidden">{variant === "short" ? `: ${site.event.full_name}` : ""}, home</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
  }
  .logo-text { display: grid; gap: 0.3rem; }
  .logo-name {
    font: 800 1.85rem / 0.85 var(--f-display);
    letter-spacing: 0.01em;
    color: var(--c-primary);
  }
  .logo--short .logo-name { font-size: 1.6rem; }
  .logo-sub {
    display: grid;
    font: 600 0.62rem / 1.3 var(--f-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .logo-sub span { white-space: nowrap; }
</style>
