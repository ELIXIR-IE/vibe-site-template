---
import type { Session } from "../lib/data";
import { hasPage } from "../lib/data";
import { url } from "../lib/url";

interface Props { session: Session }
const { session: s } = Astro.props;

const TYPE_LABEL: Record<Session["type"], string> = {
  keynote: "Keynote", talks: "Talks", panel: "Panel", workshop: "Workshop",
  posters: "Posters", break: "Break", social: "Social", opening: "Plenary",
};
const speakerLink = (id?: string) => (id && hasPage("speakers") ? url(`speakers#${id}`) : undefined);
---

<li class:list={["session", `session--${s.type}`]}>
  <p class="session-time">
    <time datetime={s.startAt} data-local-time>{s.start}</time>–<time datetime={s.endAt} data-local-time>{s.end}</time>
  </p>
  <div class="session-body">
    <p class="session-title">
      <span class:list={["tag", `tag--${s.type}`]}>{TYPE_LABEL[s.type]}</span>
      <span>{s.title}</span>
    </p>
    {s.speakerInfo && (
      <p class="session-meta">
        {speakerLink(s.speakerInfo.id)
          ? <a href={speakerLink(s.speakerInfo.id)}>{s.speakerInfo.name}</a>
          : s.speakerInfo.name}, {s.speakerInfo.affiliation}
      </p>
    )}
    {s.chair && <p class="session-meta">Chair: {s.chair}</p>}
    {s.note && <p class="session-meta">{s.note}</p>}
    {s.items.length > 0 && (
      <ul class="session-items">
        {s.items.map((it) => (
          <li>
            <span class="item-title">{it.title}</span>
            {it.by && (
              <span class="item-by">
                {speakerLink(it.speakerId) ? <a href={speakerLink(it.speakerId)}>{it.by}</a> : it.by}
              </span>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</li>

<style>
  .session {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--c-border);
  }
  .session-time { font: 500 0.9rem / 1.5 var(--f-mono); color: var(--c-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .session-body { display: grid; gap: var(--space-1); }
  .session-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); font-weight: 600; font-size: 1.05rem; }
  .session-meta { font-size: var(--fs-small); color: var(--c-muted); }
  .session-items { list-style: none; margin: var(--space-2) 0 0; padding: 0 0 0 var(--space-4); border-left: 2px solid var(--c-primary-line); display: grid; gap: var(--space-2); }
  .session-items li { display: grid; }
  .item-title { font-weight: 500; }
  .item-by { font-size: var(--fs-small); color: var(--c-muted); }
  .session--break .session-title, .session--break .session-time { color: var(--c-muted); font-weight: 500; }
  .session--keynote { background: linear-gradient(90deg, var(--c-accent-soft), transparent 70%); }
  .session--keynote, .session--break { padding-inline: var(--space-3); margin-inline: calc(-1 * var(--space-3)); border-radius: var(--radius-sm); }

  .tag--keynote { background: var(--c-accent-soft); color: var(--c-cta); }
  .tag--talks { background: var(--c-primary-soft); color: var(--c-primary-ink); }
  .tag--panel { background: var(--c-primary); color: var(--c-bg); }
  .tag--workshop { border: 1px solid var(--c-primary); color: var(--c-primary); }
  .tag--posters { border: 1px solid var(--c-accent); color: var(--c-cta); }
  .tag--break { background: var(--c-surface); color: var(--c-muted); border: 1px solid var(--c-border); }
  .tag--social { background: var(--c-surface); color: var(--c-primary-ink); border: 1px dashed var(--c-primary-line); }
  .tag--opening { background: var(--c-text); color: var(--c-bg); }

  @media (max-width: 600px) {
    .session { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
