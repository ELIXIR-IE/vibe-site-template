---
// The logo at map scale, with the institutions it represents.
import Mark from "./Mark.astro";
import { brand } from "../lib/data";

interface Props { showList?: boolean }
const { showList = true } = Astro.props;
const campusCount = brand.institutions.reduce((n, i) => n + i.campuses.length, 0);
const lit = brand.wells.filter((w) => w.campuses.length).length;
---

<div class:list={["network", { "network--solo": !showList }]}>
  <figure class="network-map">
    <Mark size={420} showCampuses label={`Map of the island of Ireland drawn as a flow cell. ${lit} coral wells mark ${campusCount} campuses.`} />
    <figcaption class="muted">
      Each coral well marks one or more campuses. Point at a well to see which.
    </figcaption>
  </figure>
  {showList && (
    <div class="network-list">
      <p class="network-stats">
        <span><b>{brand.institutions.length}</b> institutions</span>
        <span><b>{campusCount}</b> campuses</span>
      </p>
      <ul>
        {brand.institutions.map((i) => (
          <li>
            <span class="inst">{i.name}{i.short && <span class="muted"> ({i.short})</span>}</span>
            <span class="campuses">{i.campuses.join(", ")}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  .network { display: grid; grid-template-columns: minmax(0, 420px) 1fr; gap: var(--space-7); align-items: start; }
  .network--solo { grid-template-columns: minmax(0, 420px); }
  .network-map { margin: 0; display: grid; gap: var(--space-3); }
  .network-map :global(.mark) { width: 100%; height: auto; }
  .network-map :global(.mark-hit) { cursor: help; transition: r 0.15s ease; }
  .network-map :global(.mark-hit:hover) { stroke: var(--c-text); stroke-width: 0.4; }
  figcaption { font-size: var(--fs-small); }
  .network-stats { display: flex; gap: var(--space-5); color: var(--c-muted); margin-bottom: var(--space-4); }
  .network-stats b { font: 800 1.6rem / 1 var(--f-display); color: var(--c-heading); margin-right: 0.2rem; }
  .network-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 260px;
    column-gap: var(--space-6);
  }
  .network-list li {
    break-inside: avoid;
    display: grid;
    gap: 0.1rem;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--c-border);
  }
  .inst { font-weight: 600; }
  .campuses { font-size: var(--fs-small); color: var(--c-muted); }
  @media (max-width: 860px) { .network { grid-template-columns: 1fr; } .network-map { max-width: 360px; } }
</style>
