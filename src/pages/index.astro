---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SpeakerCard from "../components/SpeakerCard.astro";
import DateList from "../components/DateList.astro";
import SponsorStrip from "../components/SponsorStrip.astro";
import { speakers, timeline, sponsors, hasPage } from "../lib/data";
import { url } from "../lib/url";

const keynotes = speakers.filter((s) => s.role === "keynote");
---

<Base>
  <Hero />

  {keynotes.length > 0 && hasPage("speakers") && (
    <section class="section">
      <div class="container">
        <SectionHeading title="Keynote speakers">
          <a class="btn btn--ghost btn--small" href={url("speakers")}>All speakers</a>
        </SectionHeading>
        <div class="grid-auto" style="--min: 240px">
          {keynotes.map((s) => <SpeakerCard speaker={s} showBio={false} />)}
        </div>
      </div>
    </section>
  )}

  {hasPage("key-dates") && (
    <section class="section section--alt">
      <div class="container">
        <SectionHeading title="Key dates">
          <a class="btn btn--ghost btn--small" href={url("key-dates")}>All dates</a>
        </SectionHeading>
        <div class="narrow"><DateList items={timeline} upcomingOnly limit={5} /></div>
      </div>
    </section>
  )}

  {sponsors.length > 0 && (
    <section class="section">
      <div class="container"><SponsorStrip /></div>
    </section>
  )}
</Base>

<style>
  .narrow { max-width: 640px; }
</style>
